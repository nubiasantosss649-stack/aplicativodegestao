# Copie para .env e preencha com os dados do seu projeto Supabase.
# Estas chaves são PÚBLICAS (anon/publishable). Nunca coloque a service_role key no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Ambiente: development | staging | production
# Use um projeto Supabase separado para testes (que aceite compras sandbox).
EXPO_PUBLIC_APP_ENV=development

# Chaves PÚBLICAS do SDK RevenueCat (Project settings > API keys > App specific keys).
# Deixe vazio para desativar compras (o app nunca simula uma assinatura).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
