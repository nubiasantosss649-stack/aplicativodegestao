{
  "expo": {
    "name": "Gestão Fácil IA",
    "slug": "gestao-facil-ia",
    "scheme": "gestaofacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gestaofacilia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler o código de barras dos produtos.",
        "NSPhotoLibraryUsageDescription": "Acesso às fotos para adicionar imagens aos produtos.",
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.gestaofacilia.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E40AF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para ler o código de barras dos produtos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesso às fotos para adicionar imagens aos produtos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Gestão de vendas, estoque, clientes, fiados e finanças para pequenos negócios, com Assistente IA.",
    "primaryColor": "#1E40AF"
  }
}
