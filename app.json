{
  "expo": {
    "name": "Gestão Fácil IA",
    "slug": "gestao-facil-ia",
    "scheme": "gestaofacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gestaofacilia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler o código de barras dos produtos.",
        "NSPhotoLibraryUsageDescription": "Acesso às fotos para adicionar imagens aos produtos."
      }
    },
    "android": {
      "package": "com.gestaofacilia.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E40AF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para ler o código de barras dos produtos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesso às fotos para adicionar imagens aos produtos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
